# macOS
.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/                 # note: papers/dist/ deck files are force-added intentionally
*.docx.bak            # in-place TOC patch backups (papers/add_toc_links.py)
*.egg-info/
.eggs/
pip-wheel-metadata/

# Logs and temp files
*.log
*.tmp
*.swp
logs/

# IDE/editor settings
.idea/
.vscode/

# Jupyter
.ipynb_checkpoints/

# Local environment files
.env
.env.*

# Local datasets and generated benchmark outputs
datasets/*
!datasets/.gitkeep
outputs/20*/
outputs/jointadaspec_*_20*/
outputs/jointadaspec_*_kappa_sweep/

# Local model weights
models/*
!models/.gitkeep
